[16.769641, "o", "                                                                      \u001b[13;3H\u001b[36m\u001b[1m\u2551 Syntax:  chmod [\u001b[33mOPTION\u001b[36m] \u001b[35mMODE\u001b[36m FILE\u001b[39m\u001b[2m...\r\n\u001b[m\u000f                                                                                            \u001b[14;3H\u001b[36m\u001b[1m\u2551 Desc:    \u001b[32mChange file permissions\r\n\u001b[m\u000f                                                                                            \u001b[15;3H\u001b[36m\u001b[1m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\r\n\u001b[m\u000f                                                                                            \u001b[16;3H\u001b[36m\u001b[1m\ud83d\udd0d\u001b[H\u001b[m\u000f                                                                                            \u001b[2;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m--version\u001b[m\u000f                                                                                 \u001b[16;5H\u001b[36m\u001b[1m Fuzzy search 9 flags | Multi-select: Ctrl-A/D | Esc: Back to menu\u001b[2;13H\u001b[m\u000f\u001b[2m\u2014\u001b[m\u000f output version information and exit Each MODE is of the form '[ugoa]*([-+=].. \u001b[3;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m--help\u001b[m\u000f                                                                                    \u001b[3;10H\u001b[2m\u2014\u001b[m\u000f display this help and exit\u001b[54C \u001b[4;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m-R, --recursive\u001b[m\u000f                                                                           \u001b[4;19H\u001b[2m\u2014\u001b[m\u000f change files and directories recursively\u001b[31C \u001b[5;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m--reference=RFILE\u001b[m\u000f                                                                         \u001b[5;21H\u001b[2m\u2014\u001b[m\u000f use RFILE's mode instead of specifying MODE values.  RFILE is alway.. \u001b[6;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m--preserve-root\u001b[m\u000f                                                                           \u001b[6;19H\u001b[2m\u2014\u001b[m\u000f fail to operate recursively on '/'\u001b[37C \u001b[7;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m--no-preserve-root\u001b[m\u000f                                                                        \u001b[7;22H\u001b[2m\u2014\u001b[m\u000f do not treat '/' specially (the default)\u001b[28C \u001b[8;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m-v, --verbose\u001b[m\u000f                                                                             \u001b[8;17H\u001b[2m\u2014\u001b[m\u000f output a diagnostic for every file processed\u001b[29C \u001b[9;1H\u001b[48;5;236m \u001b[49m \u001b[33m\u001b[1m-f, --silent, --quiet\u001b[m\u000f                                                                     \u001b[9;25H\u001b[2m\u2014\u001b[m\u000f suppress most error messages\u001b[37C \u001b[10;1H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m>\u001b[m\u000f\u001b[48;5;236m \u001b[33m\u001b[1m-c, --changes\u001b[38;5;254m \u001b[m\u000f                                                                            \u001b[10;17H\u001b[38;5;254m\u001b[48;5;236m\u001b[1m\u001b[2m\u2014\u001b[m\u000f\u001b[38;5;254m\u001b[48;5;236m\u001b[1m like verbose but report only when a change is made\u001b[23C\u001b[m\u000f \u001b[17;1H \u001b[C\u001b[38;5;144m9/9 (0)\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\u000f\u001b[38;5;59m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[18;12H\u001b[34h\u001b[?25h"]
