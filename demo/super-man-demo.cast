[23.715299, "o", "38;5;109mSelect a command (Esc to exit) | Colorized: cmd=[cyan] [OPTIONS]=[yellow] FILE=[mage..\u001b[39m \u001b[16;3H \u001b[C\u001b[38;5;144m260/260\u001b[38;5;59m \u001b[78C\u001b[39m \u001b[13G\u001b[38;5;59m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[2;3H\u001b[39m\u001b[48;5;236m \u001b[49m \u001b[36mtail\u001b[39m: Display last lines of a file                        \u001b[36m\u001b[1mtail\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f [\u001b[33mFILE\u001b[39m]\u001b[2m...\u001b[m\u000f   \u001b[3;3H\u001b[48;5;236m \u001b[49m \u001b[36mhead\u001b[39m: Display first lines of a file                       \u001b[36m\u001b[1mhead\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f [\u001b[33mFILE\u001b[39m]\u001b[2m...\u001b[m\u000f   \u001b[4;3H\u001b[48;5;236m \u001b[49m \u001b[36mless\u001b[39m: View file contents with pa...                       \u001b[36m\u001b[1mless\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f [\u001b[33mFILE\u001b[39m]\u001b[2m...\u001b[m\u000f   \u001b[5;3H\u001b[48;5;236m \u001b[49m \u001b[36mcat\u001b[39m: Concatenate and display files                         \u001b[36m\u001b[1mcat\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f [\u001b[33mFILE\u001b[39m]\u001b[2m...\u001b[m\u000f   \u001b[6;3H\u001b[48;5;236m \u001b[49m \u001b[36mtouch\u001b[39m: Create empty file or upda...                        \u001b[36m\u001b[1mtouch\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f \u001b[35mFILE\u001b[39m\u001b[2m...\u001b[m\u000f   \u001b[7;3H\u001b[48;5;236m \u001b[49m \u001b[36mrmdir\u001b[39m: Remove an empty directory                      \u001b[36m\u001b[1mrmdir\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f \u001b[35mDIRECTORY\u001b[39m\u001b[2m...\u001b[m\u000f   \u001b[8;3H\u001b[48;5;236m \u001b[49m \u001b[36mmkdir\u001b[39m: Create a new directory                         \u001b[36m\u001b[1mmkdir\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f \u001b[35mDIRECTORY\u001b[39m\u001b[2m...\u001b[m\u000f   \u001b[9;3H\u001b[48;5;236m \u001b[49m \u001b[36mrm\u001b[39m: Remove files or directories                               \u001b[36m\u001b[1mrm\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f \u001b[35mFILE\u001b[39m\u001b[2m...\u001b[m\u000f   \u001b[16;91H \u001b[9;89H\u001b[2C \u001b[10;3H\u001b[48;5;236m \u001b[49m \u001b[36mmv\u001b[39m: Move or rename files and dir...                       \u001b[36m\u001b[1mmv\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f \u001b[35mSOURCE\u001b[39m DEST   \u001b[11;3H\u001b[48;5;236m \u001b[49m \u001b[36mcp\u001b[39m: Copy files and directories                            \u001b[36m\u001b[1mcp\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]\u001b[2m...\u001b[m\u000f \u001b[35mSOURCE\u001b[39m DEST   \u001b[12;3H\u001b[48;5;236m \u001b[49m \u001b[36mpwd\u001b[39m: Print the name of the curre...                                     \u001b[36m\u001b[1mpwd\u001b[m\u000f [\u001b[33mOPTION\u001b[39m]   \u001b[13;3H\u001b[48;5;236m \u001b[49m \u001b[36mcd\u001b[39m: Change the current directory                                      \u001b[36m\u001b[1mcd\u001b[m\u000f [\u001b[33mDIRECTORY\u001b[39m]   \u001b[14;3H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m>\u001b[m\u000f\u001b[48;5;236m \u001b[36m\u001b[1mls\u001b[38;5;254m: List directory contents                                 \u001b[36mls\u001b[38;5;254m [\u001b[33mOPTION\u001b[38;5;254m]\u001b[