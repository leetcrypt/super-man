[54.686864, "o", "\r\n\u001b[36m\ud83e\udd16 AI Compare\r\n\u001b[34m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n\u001b[33mQuery:\u001b[39m list the 5 largest files\r\n\u001b[34m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[30;1H\u001b[35m\u25b8\u001b[39m\r\n\u001b[29;2H\u001b[35m westenfelder/NL2SH\u001b[39m\r\n\u001b[K"]
[74.680297, "o", "\u001b[2S\u001b[2A  \u001b[32mdu -ah $(find . -type f) | sort -rh | head -n5\u001b[39m  \u001b[2m(20.0s)\u001b[m\u000f\r\n\u001b[K\r\n\u001b[K\u001b[35m\u25b8\u001b[39m\r\n\u001b[29;2H\u001b[35m qwen2.5-coder:1.5b\u001b[39m\r\n\u001b[K"]
[79.531444, "o", "\u001b[3S\u001b[3A  \u001b[32mls -lh | sort -rh | head -n 5\u001b[39m  \u001b[2m(4.8s)\u001b[m\u000f\r\n\u001b[K\r\n\u001b[2mNote: Always review AI-generated commands before running them!\u001b[m\u000f\u001b[K\r\n\u001b[K\u001b[34m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[39m\r\n\u001b[K"]
